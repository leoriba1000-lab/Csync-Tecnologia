# ---- Identificadores públicos (podem ir para o frontend) ----
META_APP_ID=
# ID da configuração do Facebook Login for Business (criada no painel do app)
META_ES_CONFIG_ID=
# Versão da Graph API usada nas chamadas servidor-a-servidor
META_GRAPH_VERSION=v23.0

# ---- Segredos (NUNCA expor no frontend) ----
META_APP_SECRET=
# Token arbitrário que você define e repete no painel de webhooks da Meta
META_WEBHOOK_VERIFY_TOKEN=

# ---- Operacional ----
# PIN de verificação em duas etapas usado ao registrar o número do cliente
WHATSAPP_REGISTRATION_PIN=
